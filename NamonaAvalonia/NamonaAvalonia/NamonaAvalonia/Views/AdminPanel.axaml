<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:viewmodels="using:NamonaAvalonia.ViewModels"
			 x:Class="NamonaAvalonia.AdminPanel"
			 x:DataType="viewmodels:AdminPanelVM">

	<Grid>

		<!-- Background -->
		<Grid.Background>
			<SolidColorBrush Color="#0f172a"/>
		</Grid.Background>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="230"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- SIDEBAR -->
		<Border Background="#020617">

			<StackPanel Margin="15" Spacing="10">

				<TextBlock Text="NAMONA"
						   FontSize="22"
						   FontWeight="Bold"
						   Foreground="#38bdf8"
						   Margin="10"/>

				<Separator Margin="0 10"/>

				<Button Classes="nav" Content="🏠 Dashboard" Command="{Binding}"/>
				<Button Classes="nav" Content="👤 Users" Command="{Binding}"/>
				<Button Classes="nav" Content="🛒 Orders" Command="{Binding}"/>
				<Button Classes="nav" Content="👕 Clothes" Command="{Binding}"/>
				<Button Classes="nav" Content="📦 Categories" Command="{Binding}"/>
				<Button Classes="nav" Content="⚧ Genders" Command="{Binding}"/>
				<Button Classes="nav" Content="🛍 Carts" Command="{Binding}"/>

			</StackPanel>

		</Border>


		<!-- MAIN AREA -->
		<Grid Grid.Column="1"
			  RowDefinitions="60,*">

			<!-- TOP BAR -->
			<Border Background="#020617"
					Padding="20">

				<Grid ColumnDefinitions="*,Auto,Auto">

					

					<Border Grid.Column="2"
							Background="#1e293b"
							CornerRadius="20">

						<TextBlock Grid.Column="1"
							   Text="❌"
							   FontSize="18"
							   Margin="20 0"
							   VerticalAlignment="Center"/>

					</Border>

				</Grid>

			</Border>


			<!-- DASHBOARD CONTENT -->
			<ScrollViewer Grid.Row="1">

				<StackPanel Margin="30" Spacing="25">

					<TextBlock Text="Dashboard"
							   FontSize="28"
							   FontWeight="Bold"
							   Foreground="White"/>


					<!-- STAT CARDS -->
					<WrapPanel>

						<Border Classes="statCard">
							<StackPanel>
								<TextBlock Text="Users"
										   Classes="cardTitle"/>
								<TextBlock Text="{Binding}"
										   Classes="cardValue"/>
							</StackPanel>
						</Border>

						<Border Classes="statCard">
							<StackPanel>
								<TextBlock Text="Orders"
										   Classes="cardTitle"/>
								<TextBlock Text="{Binding}"
										   Classes="cardValue"/>
							</StackPanel>
						</Border>

						<Border Classes="statCard">
							<StackPanel>
								<TextBlock Text="Revenue"
										   Classes="cardTitle"/>
								<TextBlock Text="{Binding}"
										   Classes="cardValue"/>
							</StackPanel>
						</Border>

						<Border Classes="statCard">
							<StackPanel>
								<TextBlock Text="Products"
										   Classes="cardTitle"/>
								<TextBlock Text="{Binding}"
										   Classes="cardValue"/>
							</StackPanel>
						</Border>

					</WrapPanel>


					<!-- TABLE / CONTENT AREA -->
					<Border Classes="panel">

						<StackPanel>

							<TextBlock Text="Recent Orders"
									   FontSize="18"
									   FontWeight="Bold"
									   Margin="0 0 0 10"/>



						</StackPanel>

					</Border>

				</StackPanel>

			</ScrollViewer>

		</Grid>

	</Grid>


	<!-- STYLES -->
	<UserControl.Styles>

		<!-- Sidebar buttons -->
		<Style Selector="Button.nav">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="#cbd5f5"/>
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="Padding" Value="12"/>
			<Setter Property="CornerRadius" Value="8"/>
		</Style>

		<Style Selector="Button.nav:pointerover">
			<Setter Property="Background" Value="#1e293b"/>
		</Style>


		<!-- Stat cards -->
		<Style Selector="Border.statCard">
			<Setter Property="Width" Value="200"/>
			<Setter Property="Height" Value="110"/>
			<Setter Property="Padding" Value="20"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Background" Value="#1e293b"/>
			<Setter Property="BoxShadow"
					Value="0 4 12 0 #00000066"/>
		</Style>

		<Style Selector="Border.statCard:pointerover">
			<Setter Property="RenderTransform" Value="scale(1.04)"/>
		</Style>


		<Style Selector="TextBlock.cardTitle">
			<Setter Property="Foreground" Value="#94a3b8"/>
			<Setter Property="FontSize" Value="14"/>
		</Style>

		<Style Selector="TextBlock.cardValue">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontSize" Value="26"/>
			<Setter Property="FontWeight" Value="Bold"/>
		</Style>
		<!-- Panel -->
		<Style Selector="Border.panel">
			<Setter Property="Background" Value="#1e293b"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Padding" Value="20"/>
			<Setter Property="BoxShadow"
					Value="0 4 15 0 #00000055"/>
		</Style>

	</UserControl.Styles>

</UserControl>