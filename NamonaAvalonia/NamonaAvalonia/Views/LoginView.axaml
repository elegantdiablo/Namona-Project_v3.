<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="640"
        x:Class="NamonaAvalonia.LoginView">

        <Grid RowDefinitions="*,Auto,*">
        <StackPanel Grid.Row="1" Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Enter Password" FontSize="18" HorizontalAlignment="Center"/>
            <TextBox Width="220" PasswordChar="*" Text="{Binding Password}"/>
            <Button Content="Login" Width="120" Height="40" Command="{Binding LoginCommand}"/>
        </StackPanel>
    </Grid>
</Window>
